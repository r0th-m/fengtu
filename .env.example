# 丰图 docker compose 环境模板(M5)。cp .env.example .env 后改口令。
# 权威出处:cmd/fengtu/main.go 头部注释(24 个 FENGTU_* 全在此)。
# .env 永不入库(.gitignore/.dockerignore 双闸)。

# ---- 口令(必填,三处必须同串;下面是占位,生产必换) ----
# POSTGRES_PASSWORD 给 postgres 容器;FENGTU_PG 里的口令段要与它一致。
# CLICKHOUSE_PASSWORD 给 clickhouse 容器;FENGTU_CH_PASS 要与它一致。
POSTGRES_PASSWORD=CHANGE_ME_pg_password
CLICKHOUSE_PASSWORD=CHANGE_ME_ch_password

# ---- 端口绑定 ----
# 丰图 web 口宿主绑定地址。缺省 127.0.0.1=仅本机(公网机的安全默认);
# 要给团队访问改成内网 IP,或保持 127.0.0.1 走 TLS 反代。
FENGTU_BIND_IP=127.0.0.1

# ---- 数据库连接(compose 内部服务名,勿改 host 段) ----
FENGTU_PG=postgres://fengtu:CHANGE_ME_pg_password@postgres:5432/fengtu
FENGTU_CH=clickhouse:9000
FENGTU_CH_USER=fengtu
FENGTU_CH_PASS=CHANGE_ME_ch_password
FENGTU_CH_COMPRESS=lz4

# ---- 监听与数据 ----
# 容器内必须 0.0.0.0(宿主侧绑定由 FENGTU_BIND_IP 收口),勿改。
FENGTU_LISTEN=0.0.0.0:8200
FENGTU_DATA_DIR=/app/data

# ---- 配置目录(镜像内 baked,缺省相对路径即以 /app 为根,一般不动) ----
FENGTU_MAP=configs/wininfosc-map.yaml
FENGTU_DESC_DIR=configs/desc
FENGTU_RULES_DIR=configs/rules
FENGTU_OPERATORS_DIR=configs/operators
FENGTU_PLAYBOOKS_DIR=configs/playbooks
FENGTU_KB_DIR=configs/kb

# ---- 会话安全 ----
# 反代 TLS 时必须 true;127.0.0.1/内网明文可 false。
FENGTU_COOKIE_SECURE=false

# ---- AI 层(全部可选;不配=AI 端点 503/外发闸关 403,如实,不影响其余功能) ----
FENGTU_AI_API_KEY=
FENGTU_AI_SECRET=
FENGTU_AI_BASE_URL=https://api.deepseek.com/v1
FENGTU_AI_MODEL=deepseek-chat
FENGTU_AI_PROVIDER=deepseek
FENGTU_AI_OUTBOUND=
FENGTU_AI_BUDGET_TOKENS=200000
FENGTU_AI_MAX_TOKENS=4096
FENGTU_INTENT_BUDGET_SECONDS=600
FENGTU_INTENT_TOKEN_BUDGET=1000000
